# Configuration preparation only; not a ready-to-deploy baseline.
# Copy outside Git only after the deployment gates in the action guide pass.
# No model keys, passwords, or existing database connection strings belong here.
AGENTEXAM_DATA_ROOT=D:/AgentExamData

# PostgreSQL 15 layout; require verified immutable image identities before use.
# Do not choose PG 18 with this data target or silently reuse an old test image.
AGENTEXAM_POSTGRES_IMAGE=
AGENTEXAM_MINIO_IMAGE=

# Owner localhost only. These defaults do not prove isolation on Docker <28.
AGENTEXAM_POSTGRES_PORT=55432
AGENTEXAM_MINIO_PORT=59000

# Future explicit initialization must create these owner-private password files:
# D:/AgentExamData/private/postgres-password
# D:/AgentExamData/private/minio-password
# Missing paths must fail; ordinary startup must never generate/replace passwords.
