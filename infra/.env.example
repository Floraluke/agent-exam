# AgentExam environment template.
#
# 1. Copy this file to infra/.env; the real file is ignored by Git.
# 2. Replace every YOUR_* value and every machine-specific absolute path.
# 3. Never commit/share infra/.env, passwords, database URLs or auth.json.
# 4. Paths use forward slashes so Docker Compose and Windows tools read them alike.

# Storage services -----------------------------------------------------------

# Absolute owner-only data root. It will contain postgres/, minio/, control/
# and private/. Example: D:/AgentExamData
AGENTEXAM_DATA_ROOT=D:/AgentExamData

# Verified linux/amd64 image identities. Keep exact digests; do not use latest.
# PostgreSQL keeps the version-15 data layout used by this project.
AGENTEXAM_POSTGRES_IMAGE=docker.io/library/postgres@sha256:a2c20749c564b4eb73a77bfda626f8a3cde1bbfae020fb97c616a00cdc1a2181
AGENTEXAM_MINIO_IMAGE=quay.io/minio/aistor/minio@sha256:dfa8e241413464755a9cd90574b15030d6a5703c74ec73928abb6d9c5f4f42ce

# Owner-loopback host ports. Change only when the chosen ports are occupied,
# and keep AGENTEXAM_DATABASE_URL / AGENTEXAM_MINIO_ENDPOINT in sync.
AGENTEXAM_POSTGRES_PORT=55432
AGENTEXAM_MINIO_PORT=59000

# HTTP and Web ---------------------------------------------------------------

# Private PostgreSQL DSN used by the HTTP process, owner commands and Worker.
# URL-encode special characters in the password. Example format only:
# postgresql://agentexam_admin:YOUR_URL_ENCODED_PASSWORD@127.0.0.1:55432/agentexam
# The password is created at DATA_ROOT/private/postgres-password; never put a
# real DSN in this public template.
AGENTEXAM_DATABASE_URL=

# Exact browser-facing origin, with scheme and optional non-default port, but
# no path or trailing slash. Tailnet example:
# https://YOUR_DEVICE.YOUR_TAILNET.ts.net
# Local-only development example: http://127.0.0.1:3000
AGENTEXAM_PUBLIC_ORIGIN=https://YOUR_DEVICE.YOUR_TAILNET.ts.net

# Set to 1 only when PUBLIC_ORIGIN is an HTTP loopback URL. Keep 0 for HTTPS.
AGENTEXAM_ALLOW_INSECURE_LOOPBACK=0

# Loopback FastAPI target used by Next.js for /api/v1 forwarding.
AGENTEXAM_API_ORIGIN=http://127.0.0.1:8000

# Catalog and object storage -------------------------------------------------

# Absolute path to the verified SWE-Gym parquet snapshot used by the catalog
# and Worker. Example: E:/your-repo/runtime/cache/swe-gym-lite/<sha>/train-0000.parquet
AGENTEXAM_TASK_PARQUET=E:/YOUR_REPOSITORY/runtime/cache/swe-gym-lite/YOUR_SNAPSHOT/train-0000.parquet

# Private MinIO endpoint on the owner machine. Only literal 127.0.0.1 may use
# HTTP; non-loopback endpoints must use HTTPS.
AGENTEXAM_MINIO_ENDPOINT=http://127.0.0.1:59000

# Bucket and least-privilege application identity created by initialization.
AGENTEXAM_MINIO_BUCKET=agentexam-private
AGENTEXAM_MINIO_ACCESS_KEY=agentexam-app

# Application password created at DATA_ROOT/private/minio-app-password.
# Put the real value only in the ignored infra/.env; never put it here.
AGENTEXAM_MINIO_SECRET_KEY=

# Owner Worker ---------------------------------------------------------------

# Absolute repository root containing apps/, framework/, infra/ and runtime/.
AGENTEXAM_PROJECT_ROOT=E:/YOUR_REPOSITORY

# Dedicated evidence directory under PROJECT_ROOT/runtime; the Worker creates
# run-specific children and refuses paths outside runtime.
AGENTEXAM_WORKER_EVIDENCE_ROOT=E:/YOUR_REPOSITORY/runtime/worker

# Absolute path to the pinned Codex 0.153.0 linux-x64 .tgz. The Worker verifies
# its exact byte count and SHA-512 before use.
AGENTEXAM_CODEX_ARCHIVE=E:/YOUR_REPOSITORY/runtime/private/codex-0.153.0-linux-x64.tgz

# Absolute path to the owner-private Codex auth.json. Supply the path only;
# never paste the JSON contents into an environment file.
AGENTEXAM_CODEX_AUTH_PATH=C:/Users/YOUR_WINDOWS_USER/.codex/auth.json

# Docker Compose additionally mounts these owner-private files derived from
# AGENTEXAM_DATA_ROOT; they are deliberately not duplicated as environment
# variables: private/postgres-password, private/minio-password and
# private/minio.license. Ordinary startup never generates or replaces them.
